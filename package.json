{
	"name": "dsh-verdict-tiered",
	"version": "0.1.0",
	"description": "Tiered permission gate for DeepSeek Harness (dsh): deterministic rules, a model classifier, and optional local ONNX triage",
	"author": "Jesset (https://github.com/jesset)",
	"contributors": [
		{
			"name": "alfiwillianz",
			"url": "https://github.com/alfiwillianz"
		}
	],
	"license": "MIT",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		}
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"dsh",
		"dsh-plugin",
		"dsh-tui",
		"deepseek-harness",
		"cordis",
		"auto-mode",
		"automode",
		"permissions",
		"security",
		"tool-call",
		"classifier",
		"ai-agent",
		"onnx",
		"lancet"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alfiwillianz/dsh-verdict-tiered.git"
	},
	"homepage": "https://github.com/alfiwillianz/dsh-verdict-tiered#readme",
	"bugs": "https://github.com/alfiwillianz/dsh-verdict-tiered/issues",
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"engines": {
		"node": "^22.19 || >=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-agent": "*",
		"@deepseek-ai/dsh-commands": "*",
		"@deepseek-ai/dsh-llm": "*",
		"@deepseek-ai/dsh-permission-presets": "*",
		"@deepseek-ai/dsh-session": "*",
		"@deepseek-ai/dsh-session-projection": "*",
		"@deepseek-ai/dsh-tools": "*",
		"@deepseek-ai/dsh-user-approval": "*",
		"@deepseek-ai/schemastery": "^3.18.1"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-commands": {
			"optional": true
		},
		"@deepseek-ai/dsh-session-projection": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.7.0"
	}
}
